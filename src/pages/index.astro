---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRESETS } from '../config/presets';
const preset = PRESETS.default;
---
<BaseLayout title={preset.seo.title} description={preset.seo.description} ogImage="/og/default.png" theme={preset.theme} from={preset.key}>
  <div class="container"><h1>{preset.headline}</h1></div>
</BaseLayout>
