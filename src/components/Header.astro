---
import { site } from '../config/site';
import { PRESETS } from '../config/presets';
import { t } from '../i18n';
import type { PresetKey } from '../lib/types';

interface Props {
  homePath: string;
  /** The preset this page belongs to; undefined on project/catalog pages (decided in the browser from ?from=). */
  from?: PresetKey;
}
const { homePath, from } = Astro.props;
// Normal ↔ Game dev switch. On a preset home it moves between preset pages; elsewhere it reloads
// the same page with or without ?from=gamedev (theme.ts keeps a clean preset's ?from= on "Normal").
const game = PRESETS.gamedev;
const pathname = Astro.url.pathname;
const current = from ? PRESETS[from].theme : undefined;
const normalHref = from ? (current === 'clean' ? PRESETS[from].path : PRESETS.default.path) : pathname;
const gameHref = from ? game.path : `${pathname}?from=${game.key}`;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href={homePath} data-preset-home>{site.name}</a>
    <nav class="site-header__nav" aria-label={t.nav.main}>
      <ul class="site-nav">
        <li><a href={`${homePath}#projects`} data-preset-home data-hash="#projects">{t.nav.projects}</a></li>
        <li><a href={`${homePath}#experience`} data-preset-home data-hash="#experience">{t.nav.experience}</a></li>
        <li><a href={`${homePath}#contact`} data-preset-home data-hash="#contact">{t.nav.contact}</a></li>
        <li><a href="/projects/" data-keep-from>{t.nav.allProjects}</a></li>
        <li><a href={site.cv} download>{t.nav.cv}</a></li>
      </ul>
    </nav>
    <div class="view-switch-wrap">
      <div class="view-switch" role="group" aria-label={t.view.label} data-view-switch>
        <a class="view-switch__opt" href={normalHref} data-view="clean" data-keep-clean-from={from ? undefined : ''} aria-current={current === 'clean' ? 'page' : undefined}>{t.view.normal}</a>
        <a class="view-switch__opt" href={gameHref} data-view="game" aria-current={current === 'game' ? 'page' : undefined}>
          <span aria-hidden="true">🎮</span> {t.view.game}<span class="view-switch__long">{t.view.gameLong}</span>
        </a>
      </div>
      <div class="view-hint" role="status" data-view-hint hidden>
        <a class="view-hint__link" href={gameHref} data-view-hint-link>{t.view.hint}</a>
        <button type="button" class="view-hint__close" aria-label={t.view.dismiss} data-view-hint-close>×</button>
      </div>
    </div>
    <button type="button" class="scheme-toggle" data-scheme-toggle data-js-only aria-label={t.theme.toggle}>
      <span class="scheme-toggle__icon" aria-hidden="true"></span>
    </button>
  </div>
</header>
