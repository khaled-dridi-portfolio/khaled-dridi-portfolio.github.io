---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  logo?: ImageMetadata;
  background?: string;
  size?: number;
}
const { title, logo, background, size = 56 } = Astro.props;
---
{logo ? (
  <Image class="project-logo" src={logo} alt="" width={size * 2} style={`--size:${size}px` + (background ? `;--logo-bg:${background}` : '')} data-project-logo />
) : (
  <span class="project-logo project-logo--fallback" style={`--size:${size}px`} aria-hidden="true" data-project-logo-fallback>
    {title.trim().charAt(0).toUpperCase()}
  </span>
)}
