---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import EmbedFacade from './EmbedFacade.astro';
import { youtubeEmbedUrl, youtubeWatchUrl, type VideoSource } from '../lib/video';
import { t } from '../i18n';

interface Props {
  video: VideoSource;
  title: string;
  poster?: ImageMetadata;
}
const { video, title, poster } = Astro.props;
// A local video uses the cover as its poster; the poster's size gives the video's aspect ratio (no layout shift).
const posterSrc = video.kind === 'file' && poster ? (await getImage({ src: poster, width: poster.width })).src : undefined;
---
{video.kind === 'file' ? (
  <video
    class="video-file"
    src={video.src}
    controls
    preload="metadata"
    playsinline
    poster={posterSrc}
    width={poster?.width}
    height={poster?.height}
    data-orientation={poster && poster.height > poster.width ? 'portrait' : undefined}
    data-autoplay
  ></video>
) : (
  <EmbedFacade
    kind="video"
    src={youtubeEmbedUrl(video.id)}
    fallbackHref={youtubeWatchUrl(video.id)}
    title={title}
    label={t.project.playVideo}
    poster={poster}
  />
)}

<script>
  import { autoplayVideos } from '../scripts/autoplay';
  autoplayVideos();
</script>
