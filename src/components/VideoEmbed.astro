---
import type { ImageMetadata } from 'astro';
import EmbedFacade from './EmbedFacade.astro';
import { youtubeEmbedUrl, youtubeWatchUrl, type VideoSource } from '../lib/video';
import { t } from '../i18n';

interface Props {
  video: VideoSource;
  title: string;
  poster?: ImageMetadata;
}
const { video, title, poster } = Astro.props;
---
{video.kind === 'file' ? (
  <video class="video-file" src={video.src} controls preload="metadata"></video>
) : (
  <EmbedFacade
    kind="video"
    src={youtubeEmbedUrl(video.id)}
    fallbackHref={youtubeWatchUrl(video.id)}
    title={title}
    label={t.project.playVideo}
    poster={poster}
  />
)}
