---
import { t } from '../i18n';
import type { ProjectType } from '../lib/types';

// Projects deliberately show no dates (owner's choice); startDate is only used for ordering.
interface Props {
  role?: string;
  type?: ProjectType;
}
const { role, type } = Astro.props;
const parts = [role, type ? t.projects.types[type] : undefined].filter((p): p is string => Boolean(p));
---
{parts.length > 0 && <p class="project-meta">{parts.map((part) => <span class="project-meta__item">{part}</span>)}</p>}
