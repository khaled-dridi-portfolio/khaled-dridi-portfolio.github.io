---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProjectLogo from './ProjectLogo.astro';
import ProjectMeta from './ProjectMeta.astro';
import TagList from './TagList.astro';
import { t } from '../i18n';
import type { PresetKey } from '../lib/types';

interface Props {
  project: CollectionEntry<'projects'>;
  from: PresetKey;
}
const { project, from } = Astro.props;
const d = project.data;
---
<article
  class:list={['project-card', { 'project-card--featured': d.featured }]}
  data-project-card
  data-id={project.id}
  data-category={d.category}
  data-tags={d.tags.join('|')}
  data-start={d.startDate?.toISOString() ?? ''}
  style={d.accentColor ? `--project-accent: ${d.accentColor}` : undefined}
>
  <div class="project-card__media">
    {d.cover ? (
      <Image class="project-card__cover" src={d.cover} alt="" width={720} />
    ) : (
      <div class="project-card__placeholder"><ProjectLogo title={d.title} logo={d.logo} size={72} /></div>
    )}
    {d.previewClip && (
      <video class="project-card__preview" src={d.previewClip} muted loop playsinline preload="none" aria-hidden="true" data-preview-clip></video>
    )}
  </div>
  <div class="project-card__body">
    <div class="project-card__head">
      {d.cover && <ProjectLogo title={d.title} logo={d.logo} size={40} />}
      <h3 class="project-card__title" data-title-font={d.titleFont}>
        <a class="project-card__link" href={`/projects/${project.id}/?from=${from}`} data-keep-from>{d.title}</a>
      </h3>
    </div>
    <ProjectMeta role={d.role} type={d.type} startDate={d.startDate} endDate={d.endDate} />
    {d.summary && <p class="project-card__summary">{d.summary}</p>}
    <TagList items={d.features} label={t.projects.features} variant="feature" />
    <TagList items={d.tags} />
  </div>
</article>
