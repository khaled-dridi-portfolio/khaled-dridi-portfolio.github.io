---
import type { CollectionEntry } from 'astro:content';
import ProjectGrid from './ProjectGrid.astro';
import { t } from '../i18n';
import type { PresetKey } from '../lib/types';

interface Props {
  projects: CollectionEntry<'projects'>[];
  from: PresetKey;
}
const { projects, from } = Astro.props;
---
<section id="projects" class="section" data-section="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section__head">
      <h2 id="projects-title" class="section__title">{t.sections.projects}</h2>
      <a class="section__more" href="/projects/" data-keep-from>{t.nav.allProjects} →</a>
    </div>
    <ProjectGrid projects={projects} from={from} />
  </div>
</section>
